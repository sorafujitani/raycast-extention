{
  "name": "personal-raycast-extensions",
  "private": true,
  "workspaces": [
    "raytodo",
    "gh-assigned",
    "ray-dsl-viewer"
  ],
  "type": "module",
  "scripts": {
    "check": "npm run check:public && vp check && npm run typecheck --workspaces",
    "check:public": "node scripts/check-public-files.mjs",
    "test": "vp test",
    "fmt": "vp fmt",
    "lint:raycast": "npm run lint:raycast --workspaces",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "vite-plus": "0.3.1"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@11.18.0"
}
