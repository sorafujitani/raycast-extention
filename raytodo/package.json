{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raytodo",
  "description": "Manage daily tasks with raytodo and longer-term plans with rayteam",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "author": "fujitanisora0414",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/init-data.mjs",
    "dev": "ray develop",
    "build": "ray build -e dist -o dist",
    "typecheck": "tsc --noEmit",
    "lint:raycast": "ray lint",
    "test": "vp test --root .. raytodo/tests"
  },
  "dependencies": {
    "@raycast/api": "1.104.9"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1",
    "typescript": "^5.8.2"
  },
  "icon": "icon.png",
  "commands": [
    {
      "name": "raytodo",
      "title": "raytodo",
      "description": "Add, edit and complete tasks in todo.md",
      "mode": "view"
    },
    {
      "name": "rayteam",
      "title": "rayteam",
      "description": "Manage tasks for this week, month, year and someday",
      "keywords": [
        "week",
        "month",
        "year",
        "future",
        "plan",
        "いつか"
      ],
      "mode": "view"
    }
  ],
  "platforms": [
    "macOS"
  ],
  "title": "raytodo & rayteam"
}
